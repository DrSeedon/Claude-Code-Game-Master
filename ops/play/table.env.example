# /etc/dnd-play/<table>.env: one online table's own settings, read by dnd-play@<table>.service after the shared
# /etc/dnd-play/dnd-play.env. No secrets, except the hub webhook below (then mode 0600, root:root). Install for the demo
# table, for example:
#   sudo install -m 644 ops/play/table.env.example /etc/dnd-play/demo.env   (then edit the two values)
# After a change: sudo systemctl restart dnd-play@<table>.

# The table's screen server port: play 18116, demo 18118 (the nginx map $dnd_play_port must agree). It is written
# into world-state/online-<table>.json when the table's config is first created; a later change goes there too.
DM_PLAY_PORT=18118
# Shown by the status command.
DM_SCREEN_PUBLIC_URL=https://dnd-demo.seedon.ru/

# The hub master (owner decisions 2026-10-28 and 2026-10-31, ops/play/README.md "Hub master"): since 2026-10-31 both
# tables, each with its own T3 thread and webhook (the default is "sdk"). The webhook URL holds a token: it lives only
# in /etc/dnd-play/<table>.env on the VPS (mode 0600, root:root), never in Git; the driver removes it from its
# environment at start and logs only "set" or "unset".
#DM_PLAY_MASTER=hub
#DM_PLAY_HUB_WEBHOOK=<the T3 webhook URL of the hub master's scheduled task>
# "sdk" (the default): a batch the hub misses goes to the SDK master on the VPS. "none": it fails and the players are
# asked to repeat it; the hub is never paused. Both tables set none since 2026-10-31 (no VPS subscription).
#DM_PLAY_HUB_FALLBACK=none
# Seconds the hub has to publish a batch; with the sdk fallback, consecutive hub failures before a pause and seconds of
# the pause (the SDK master plays meanwhile).
#DM_PLAY_HUB_TIMEOUT=300
#DM_PLAY_HUB_FAILS=2
#DM_PLAY_HUB_PAUSE=900

# The master console on the page (owner request 2026-10-28, lib/screen/masterlog.py): "1" shows everyone at the table
# what the master was given, says and runs, hidden rolls and plot notes included (spoilers). The play table sets it,
# the demo table keeps it off (the default). The driver writes <screen>/master-log.jsonl either way.
#DM_SCREEN_MASTER_CONSOLE=1
