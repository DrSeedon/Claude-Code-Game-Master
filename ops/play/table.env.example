# /etc/dnd-play/<table>.env: one online table's own settings, read by dnd-play@<table>.service after the shared
# /etc/dnd-play/dnd-play.env. No secrets, except the hub webhook below (the play table only). Install for the demo
# table, for example:
#   sudo install -m 644 ops/play/table.env.example /etc/dnd-play/demo.env   (then edit the two values)
# After a change: sudo systemctl restart dnd-play@<table>.

# The table's screen server port: play 18116, demo 18118 (the nginx map $dnd_play_port must agree). It is written
# into world-state/online-<table>.json when the table's config is first created; a later change goes there too.
DM_PLAY_PORT=18118
# Shown by the status command.
DM_SCREEN_PUBLIC_URL=https://dnd-demo.seedon.ru/

# The hub master (owner decision 2026-10-28, ops/play/README.md "Hub master (play table)"): the play table only; the
# demo table stays with the SDK master (the default, "sdk"). The webhook URL holds a token: it lives only in
# /etc/dnd-play/play.env on the VPS (mode 0600, root:root), never in Git; the driver removes it from its environment
# at start and logs only "set" or "unset".
#DM_PLAY_MASTER=hub
#DM_PLAY_HUB_WEBHOOK=<the T3 webhook URL of the hub master's scheduled task>
# Seconds the hub has to publish a batch before the SDK master plays it; consecutive hub failures before a pause;
# seconds of the pause (the SDK master plays meanwhile).
#DM_PLAY_HUB_TIMEOUT=300
#DM_PLAY_HUB_FAILS=2
#DM_PLAY_HUB_PAUSE=900
