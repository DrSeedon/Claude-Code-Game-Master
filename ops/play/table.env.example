# /etc/dnd-play/<table>.env: one online table's own settings, read by dnd-play@<table>.service after the shared
# /etc/dnd-play/dnd-play.env. No secrets. Install for the demo table, for example:
#   sudo install -m 644 ops/play/table.env.example /etc/dnd-play/demo.env   (then edit the two values)
# After a change: sudo systemctl restart dnd-play@<table>.

# The table's screen server port: play 18116, demo 18118 (the nginx map $dnd_play_port must agree). It is written
# into world-state/online-<table>.json when the table's config is first created; a later change goes there too.
DM_PLAY_PORT=18118
# Shown by the status command.
DM_SCREEN_PUBLIC_URL=https://dnd-demo.seedon.ru/
