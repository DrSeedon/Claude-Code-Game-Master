# /etc/apparmor.d/dnd-play-master: the online table masters, dnd-play@<table>.service (AppArmorProfile=dnd-play-master-%i).
# Why (TODO.md, found 2026-10-27): the master runs as kesha, and every other kesha process (Orchestra, the hub tunnel,
# the bots) shows in /proc. /proc/<pid>/root of a process outside the unit is the host filesystem, so the unit's
# hidden home and ~/.ssh were one path away. AppArmor mediates the ptrace access that /proc/<pid>/root, environ, mem
# and fd need, and signals: each profile grants both only among its own processes. Files, network and IPC stay open;
# the unit's mount sandbox decides what exists.
# One profile per table (2026-10-28, hub master review): with one shared label the guests' demo master could read the
# play driver's /proc/<pid>/environ and fd of the play unit. A new table needs its own block here, named
# dnd-play-master-<table>, before its unit starts (the unit does not start without its profile).
# Install: sudo install -m 644 ops/play/apparmor-dnd-play-master /etc/apparmor.d/dnd-play-master &&
#          sudo apparmor_parser -r /etc/apparmor.d/dnd-play-master

abi <abi/4.0>,
include <tunables/global>

profile dnd-play-master-play flags=(attach_disconnected) {
  file,
  network,
  unix,
  dbus,
  mqueue,
  # The driver stops its children; systemd stops the unit.
  signal (send, receive) peer=dnd-play-master-play,
  signal (receive) peer=unconfined,
  # Its own processes only: no /proc/<pid>/root, environ or fd of anything else, the other tables included.
  ptrace (read, trace, readby, tracedby) peer=dnd-play-master-play,
  # journald and an admin's ps may still read the master's own /proc entries.
  ptrace (readby) peer=unconfined,
}

profile dnd-play-master-demo flags=(attach_disconnected) {
  file,
  network,
  unix,
  dbus,
  mqueue,
  signal (send, receive) peer=dnd-play-master-demo,
  signal (receive) peer=unconfined,
  ptrace (read, trace, readby, tracedby) peer=dnd-play-master-demo,
  ptrace (readby) peer=unconfined,
}
