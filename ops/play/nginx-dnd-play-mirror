# dnd-play.seedon.ru and dnd-demo.seedon.ru: RU mirror of the online screen tables on Contabo (158.220.127.161), owner
# decisions 2026-10-26 (the table) and 2026-10-27 (a second, guest table). Same pattern as dnd-table-mirror: the company
# domain points to this RU IP, never to the German one. Each name's upstream is its table's Contabo vhost,
# <table>-158-220-127-161.sslip.io (ops/play/nginx-dnd-play-sslip, the map below), which checks the password and
# sends the security headers. This hop passes the guest's login cookie and the password form through unchanged (nginx
# forwards client headers and Set-Cookie by default) and appends the guest's address to X-Forwarded-For for the limits
# there. The screen does not check Origin, so there is no Origin mapping.
# Installed as /etc/nginx/sites-available/dnd-play-mirror, linked from sites-enabled (included inside http).
# On this host touch only this file and its link.

# $uri, not $request: the page sends the screen token as ?token= on /api/events and /audio/.
log_format dnd_play_mirror '$remote_addr $host [$time_local] "$request_method $uri $server_protocol" '
                           '$status $body_bytes_sent $request_time "$http_user_agent"';

# Public name -> its table's Contabo name (TLS name and Host upstream).
map $host $dnd_play_upstream {
    dnd-play.seedon.ru play-158-220-127-161.sslip.io;
    dnd-demo.seedon.ru demo-158-220-127-161.sslip.io;
}

server {
    listen 80;
    server_name dnd-play.seedon.ru dnd-demo.seedon.ru;
    access_log /var/log/nginx/dnd-play-mirror-access.log dnd_play_mirror;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name dnd-play.seedon.ru dnd-demo.seedon.ru;

    ssl_certificate /etc/letsencrypt/live/seedon.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seedon.ru/privkey.pem;

    access_log /var/log/nginx/dnd-play-mirror-access.log dnd_play_mirror;
    error_log /var/log/nginx/dnd-play-mirror-error.log warn;

    # Microphone recordings up to 8 MiB, as on Contabo; the page reads a JSON "error".
    client_max_body_size 8m;
    error_page 413 = @dnd_play_large;

    location / {
        proxy_pass https://158.220.127.161;
        proxy_ssl_server_name on;
        proxy_ssl_name $dnd_play_upstream;
        # The guests' password crosses this hop: verify the Contabo certificate (dnd-table-mirror does not).
        proxy_ssl_verify on;
        # Let's Encrypt chains are 5 deep since the 2026 roots (leaf, YE1, Root YE, ISRG Root X2, ISRG Root X1);
        # depth 3 failed intermittently with "unable to get local issuer certificate" (502).
        proxy_ssl_verify_depth 5;
        # A resumed upstream session carries no intermediates (YE1, Root YE are not in this host's CA store), so
        # about 1 request in 20 failed verification with session reuse on.
        proxy_ssl_session_reuse off;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $dnd_play_upstream;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        # Server-Sent Events and microphone uploads stream straight through.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location @dnd_play_large {
        default_type application/json;
        return 413 '{"error":"too large"}';
    }
}
