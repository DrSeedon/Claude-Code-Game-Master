# dnd-play.seedon.ru: RU mirror of the online screen table on Contabo (158.220.127.161), owner decision 2026-10-26.
# Same pattern as dnd-table-mirror: the company domain points to this RU IP, never to the German one. The upstream
# is the Contabo vhost play-158-220-127-161.sslip.io (ops/play/nginx-dnd-play-sslip), which checks the password and
# sends the security headers. This hop passes the guest's Authorization header through unchanged (nginx forwards
# client headers by default) and appends the guest's address to X-Forwarded-For for the limits there. The screen
# does not check Origin, so there is no Origin mapping.
# Installed as /etc/nginx/sites-available/dnd-play-mirror, linked from sites-enabled (included inside http).
# On this host touch only this file and its link.

# $uri, not $request: the page sends the screen token as ?token= on /api/events and /audio/.
log_format dnd_play_mirror '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                           '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 80;
    server_name dnd-play.seedon.ru;
    access_log /var/log/nginx/dnd-play-mirror-access.log dnd_play_mirror;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name dnd-play.seedon.ru;

    ssl_certificate /etc/letsencrypt/live/seedon.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seedon.ru/privkey.pem;

    access_log /var/log/nginx/dnd-play-mirror-access.log dnd_play_mirror;
    error_log /var/log/nginx/dnd-play-mirror-error.log warn;

    # Microphone recordings up to 8 MiB, as on Contabo; the page reads a JSON "error".
    client_max_body_size 8m;
    error_page 413 = @dnd_play_large;

    location / {
        proxy_pass https://158.220.127.161;
        proxy_ssl_server_name on;
        proxy_ssl_name play-158-220-127-161.sslip.io;
        # The guests' password crosses this hop: verify the Contabo certificate (dnd-table-mirror does not).
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host play-158-220-127-161.sslip.io;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        # Server-Sent Events and microphone uploads stream straight through.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location @dnd_play_large {
        default_type application/json;
        return 413 '{"error":"too large"}';
    }
}
