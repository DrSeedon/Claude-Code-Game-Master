# The online HTML screen tables on Contabo, one 443 server per table (owner decisions 2026-10-26 and 2026-10-27):
#   play-158-220-127-161.sslip.io -> dnd-play@play (127.0.0.1:18116), public name https://dnd-play.seedon.ru (the owner's)
#   demo-158-220-127-161.sslip.io -> dnd-play@demo (127.0.0.1:18118), public name https://dnd-demo.seedon.ru (guests)
# The public names go through the RU mirror (89.23.102.244, vhost dnd-play-mirror), which proxies to these; the sslip
# names also answer directly. The password gate, the security headers and the proxy live in the shared snippet
# /etc/nginx/snippets/dnd-play-table.conf (ops/play/nginx-dnd-play-table.conf), included by each table's server.
# Installed as /etc/nginx/sites-available/dnd-play-sslip, linked from sites-enabled, so this file is included
# inside the http block (zones, maps and log_format below are http-level). The limit zones are shared: one guest's
# rate counts across both tables.
#
# A new table's 443 server needs its certificate, so first install this file WITHOUT that table's lines from
# "# ---- <table> 443 BEGIN" to "# ---- <table> 443 END", issue the certificate with certbot (webroot /var/www/html,
# like table-158-220-127-161.sslip.io), then install the whole file (ops/play/README.md).

# Each table's screen server port, by the server that took the request.
map $server_name $dnd_play_port {
    play-158-220-127-161.sslip.io 18116;
    demo-158-220-127-161.sslip.io 18118;
}

# Per-client limits. The client is the guest, not the mirror: see set_real_ip_from below.
limit_req_zone $binary_remote_addr zone=dnd_play_all:1m rate=10r/s;
limit_req_zone $binary_remote_addr zone=dnd_play_action:1m rate=10r/m;
limit_req_zone $binary_remote_addr zone=dnd_play_voice:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=dnd_play_speech:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=dnd_play_log:1m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=dnd_play_conn:1m;
# Password tries: only POST /login counts (an empty key is not limited), so reloading the form costs nothing.
map $request_method $dnd_play_login_key {
    POST $binary_remote_addr;
    default "";
}
limit_req_zone $dnd_play_login_key zone=dnd_play_login:1m rate=6r/m;

# $uri, not $request, and no referer: the page sends the screen token as ?token= on /api/events and /audio/.
log_format dnd_play '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name play-158-220-127-161.sslip.io demo-158-220-127-161.sslip.io;
    access_log /var/log/nginx/dnd-play-access.log dnd_play;

    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- play 443 BEGIN: enable only after certbot issued /etc/letsencrypt/live/play-158-220-127-161.sslip.io/
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name play-158-220-127-161.sslip.io;

    ssl_certificate /etc/letsencrypt/live/play-158-220-127-161.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play-158-220-127-161.sslip.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/dnd-play-access.log dnd_play;
    error_log /var/log/nginx/dnd-play-error.log warn;

    include /etc/nginx/snippets/dnd-play-table.conf;
}
# ---- play 443 END

# ---- demo 443 BEGIN: enable only after certbot issued /etc/letsencrypt/live/demo-158-220-127-161.sslip.io/
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name demo-158-220-127-161.sslip.io;

    ssl_certificate /etc/letsencrypt/live/demo-158-220-127-161.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo-158-220-127-161.sslip.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/dnd-demo-access.log dnd_play;
    error_log /var/log/nginx/dnd-demo-error.log warn;

    include /etc/nginx/snippets/dnd-play-table.conf;
}
# ---- demo 443 END
