# /etc/dnd-play/dnd-play.env: caps and model of the online table (dnd-play.seedon.ru), read by dnd-play.service.
# No secrets here. ELEVENLABS_API_KEY and DEEPGRAM_API_KEY stay in the project .env; the master thinks on kesha's
# Claude subscription (~/.claude), never on an API key.
# Install: sudo install -d -m 755 /etc/dnd-play && sudo install -m 644 ops/play/dnd-play.env.example /etc/dnd-play/dnd-play.env
# After a change: sudo systemctl restart dnd-play.

# Screen server (lib/screen). 0 means no cap, which is the laptop default; dnd-play.service sets these online values as
# defaults too, so a line missing here never lifts a cap.
# ElevenLabs credits a day for the speech the players request with the speaker button.
DM_SCREEN_DAILY_CREDITS=15000
# The most one turn may cost; a dearer turn is refused before anything is spent.
DM_SCREEN_TURN_CREDITS=1500
# 0: music, ambience and effects come only from the library and free sources, never generated.
DM_SCREEN_SOUND_GENERATION=0
# /api/action answers 429 while more than this many actions wait for the master.
DM_SCREEN_MAX_PENDING=10
# Megabytes of microphone recordings a day sent to speech recognition.
DM_SCREEN_DAILY_VOICE_MB=200
# One daily ledger of credits and microphone bytes for the whole table, whatever campaign plays (the driver's default).
# DM_SCREEN_SPEND_FILE=/home/kesha/projects/dnd-game-master/world-state/usage/screen-spend.json
# Shown by the status and start commands.
DM_SCREEN_PUBLIC_URL=https://dnd-play.seedon.ru/

# Driver (backend.screen_driver).
DM_PLAY_MODEL=claude-sonnet-5-5
DM_PLAY_EFFORT=medium
DM_PLAY_MAX_TURNS_PER_HOUR=30
DM_PLAY_MAX_TURNS_PER_DAY=200
# Seconds one master turn may take before the driver interrupts it.
DM_PLAY_TURN_TIMEOUT=600
# Table state file, relative to the repository (the default).
# DM_PLAY_CONFIG=world-state/online-play.json
