{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/r7/transport-schemas-v1.json",
  "title": "R7 application WebSocket messages",
  "description": "Closed application messages after an R8-authenticated WebSocket upgrade. Projection envelopes validate separately against projection-schemas.json.",
  "oneOf": [
    { "$ref": "#/$defs/ClientHello" },
    { "$ref": "#/$defs/ActorSelect" },
    { "$ref": "#/$defs/DraftSubmit" },
    { "$ref": "#/$defs/DraftApprove" },
    { "$ref": "#/$defs/DraftReject" },
    { "$ref": "#/$defs/ProjectionAck" },
    { "$ref": "#/$defs/OverlayCreate" },
    { "$ref": "#/$defs/OverlayRemove" },
    { "$ref": "#/$defs/AudioCandidate" },
    { "$ref": "#/$defs/AudioRenew" },
    { "$ref": "#/$defs/AdminOperation" },
    { "$ref": "#/$defs/ServerWelcome" },
    { "$ref": "#/$defs/ResyncRequired" },
    { "$ref": "#/$defs/OverlaySnapshot" },
    { "$ref": "#/$defs/OverlayEvent" },
    { "$ref": "#/$defs/AudioLease" },
    { "$ref": "#/$defs/AudioPlay" },
    { "$ref": "#/$defs/AudioStop" },
    { "$ref": "#/$defs/OperationResult" }
  ],
  "x-auth-boundary": {
    "upgrade": "R8 Secure HttpOnly session cookie + exact Origin + single-use purpose-bound WS ticket; no bearer in URL",
    "message_authority": "room, role, actor set, consumer ID, and capabilities come only from the server session/socket context",
    "unknown_fields": "reject and audit; never ignore an authority-looking field",
    "reconnect": "a reconnect resumes projections only; it never replays an approval, admin operation, or typed command"
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Version": { "type": "integer", "minimum": 0 },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "y": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "ReducerVersions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "table.v1": { "type": "integer", "minimum": 1 },
        "scene.v1": { "type": "integer", "minimum": 1 },
        "admin.v1": { "type": "integer", "minimum": 1 }
      }
    },
    "ClientHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "rehydrate", "reducer_versions"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "client.hello" },
        "rehydrate": { "type": "boolean" },
        "reducer_versions": { "$ref": "#/$defs/ReducerVersions" }
      }
    },
    "ActorSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "selection_id", "actor_id", "expected_aggregate_version"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "actor.select" },
        "selection_id": { "$ref": "#/$defs/Identifier" },
        "actor_id": { "$ref": "#/$defs/Identifier" },
        "expected_aggregate_version": { "$ref": "#/$defs/Version" }
      }
    },
    "DraftSubmit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "command_id", "final_transcript_id", "text", "expected_aggregate_version"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "draft.submit" },
        "command_id": { "$ref": "#/$defs/Identifier" },
        "final_transcript_id": { "$ref": "#/$defs/Identifier" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "expected_aggregate_version": { "$ref": "#/$defs/Version" }
      }
    },
    "DraftApprove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "turn_id", "draft_version", "approval_nonce"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "draft.approve" },
        "turn_id": { "$ref": "#/$defs/Identifier" },
        "draft_version": { "type": "integer", "minimum": 1 },
        "approval_nonce": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    },
    "DraftReject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "turn_id", "draft_version", "approval_nonce"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "draft.reject" },
        "turn_id": { "$ref": "#/$defs/Identifier" },
        "draft_version": { "type": "integer", "minimum": 1 },
        "approval_nonce": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    },
    "ProjectionAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "event_id", "projection_batch_id", "surface", "stream_seq", "projection_schema", "reducer_version"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "projection.ack" },
        "event_id": { "$ref": "#/$defs/Identifier" },
        "projection_batch_id": { "$ref": "#/$defs/Identifier" },
        "surface": { "enum": ["table", "scene", "admin"] },
        "stream_seq": { "$ref": "#/$defs/Version" },
        "projection_schema": { "enum": ["table.v1", "scene.v1", "admin.v1"] },
        "reducer_version": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "surface": { "const": "table" } } },
          "then": { "properties": { "projection_schema": { "const": "table.v1" } } }
        },
        {
          "if": { "properties": { "surface": { "const": "scene" } } },
          "then": { "properties": { "projection_schema": { "const": "scene.v1" } } }
        },
        {
          "if": { "properties": { "surface": { "const": "admin" } } },
          "then": { "properties": { "projection_schema": { "const": "admin.v1" } } }
        }
      ]
    },
    "OverlayCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "command_id", "overlay_id", "overlay_kind", "points", "ttl_ms"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "overlay.create" },
        "command_id": { "$ref": "#/$defs/Identifier" },
        "overlay_id": { "$ref": "#/$defs/Identifier" },
        "overlay_kind": { "enum": ["arrow", "marker"] },
        "points": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/Point" } },
        "ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 30000 }
      }
    },
    "OverlayRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "command_id", "overlay_id"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "overlay.remove" },
        "command_id": { "$ref": "#/$defs/Identifier" },
        "overlay_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AudioCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "audio_unlocked", "max_buffer_ms", "client_monotonic_ms"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "audio.candidate" },
        "audio_unlocked": { "type": "boolean" },
        "max_buffer_ms": { "type": "integer", "minimum": 0, "maximum": 250 },
        "client_monotonic_ms": { "$ref": "#/$defs/Version" }
      }
    },
    "AudioRenew": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "lease_id", "generation", "client_monotonic_ms", "buffered_ms"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "audio.renew" },
        "lease_id": { "$ref": "#/$defs/Identifier" },
        "generation": { "$ref": "#/$defs/Version" },
        "client_monotonic_ms": { "$ref": "#/$defs/Version" },
        "buffered_ms": { "type": "integer", "minimum": 0, "maximum": 250 }
      }
    },
    "AdminOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "operation_id", "expected_control_revision", "operation", "parameters"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "admin.operation" },
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "expected_control_revision": { "$ref": "#/$defs/Version" },
        "operation": { "enum": ["start", "pause", "end", "diagnostics", "set_volume", "cancel_generation", "cancel_audio", "reproject_last_safe", "retry_unfinished_stage"] },
        "parameters": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "enum": ["start", "pause", "end", "diagnostics", "cancel_generation", "cancel_audio", "reproject_last_safe"] } } },
          "then": { "properties": { "parameters": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "operation": { "const": "set_volume" } } },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["volume"],
                "properties": { "volume": { "type": "number", "minimum": 0, "maximum": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "retry_unfinished_stage" } } },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target_stage_id"],
                "properties": { "target_stage_id": { "$ref": "#/$defs/Identifier" } }
              }
            }
          }
        }
      ]
    },
    "ServerWelcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "connection_id", "consumer_id", "room_id", "server_role", "projection_surfaces", "capabilities", "server_now_ms", "heartbeat_ms", "snapshot_required"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "server.welcome" },
        "connection_id": { "$ref": "#/$defs/Identifier" },
        "consumer_id": { "$ref": "#/$defs/Identifier" },
        "room_id": { "$ref": "#/$defs/Identifier" },
        "server_role": { "enum": ["table", "scene", "admin"] },
        "projection_surfaces": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["table", "scene", "admin"] } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "server_now_ms": { "$ref": "#/$defs/Version" },
        "heartbeat_ms": { "type": "integer", "minimum": 1000, "maximum": 30000 },
        "snapshot_required": { "type": "boolean" }
      }
    },
    "ResyncRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "surface", "reason"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "projection.resync_required" },
        "surface": { "enum": ["table", "scene", "admin"] },
        "reason": { "enum": ["gap", "cursor_unknown", "schema_mismatch", "snapshot_required"] }
      }
    },
    "OverlayItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "overlay_kind", "points", "creator_ref", "created_at_ms", "expires_at_ms", "overlay_seq"],
      "properties": {
        "overlay_id": { "$ref": "#/$defs/Identifier" },
        "overlay_kind": { "enum": ["arrow", "marker"] },
        "points": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/Point" } },
        "creator_ref": { "$ref": "#/$defs/Identifier" },
        "created_at_ms": { "$ref": "#/$defs/Version" },
        "expires_at_ms": { "$ref": "#/$defs/Version" },
        "overlay_seq": { "$ref": "#/$defs/Version" }
      }
    },
    "OverlaySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "server_now_ms", "overlay_seq", "items"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "overlay.snapshot" },
        "server_now_ms": { "$ref": "#/$defs/Version" },
        "overlay_seq": { "$ref": "#/$defs/Version" },
        "items": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/OverlayItem" } }
      }
    },
    "OverlayEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "overlay_seq", "overlay_id", "item"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "enum": ["overlay.upsert", "overlay.expired", "overlay.removed"] },
        "overlay_seq": { "$ref": "#/$defs/Version" },
        "overlay_id": { "$ref": "#/$defs/Identifier" },
        "item": { "oneOf": [{ "$ref": "#/$defs/OverlayItem" }, { "type": "null" }] }
      }
    },
    "AudioLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "lease_id", "generation", "consumer_id", "not_before_server_ms", "expires_at_server_ms", "max_buffer_ms"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "audio.lease" },
        "lease_id": { "$ref": "#/$defs/Identifier" },
        "generation": { "$ref": "#/$defs/Version" },
        "consumer_id": { "$ref": "#/$defs/Identifier" },
        "not_before_server_ms": { "$ref": "#/$defs/Version" },
        "expires_at_server_ms": { "$ref": "#/$defs/Version" },
        "max_buffer_ms": { "const": 250 }
      }
    },
    "AudioPlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "lease_id", "generation", "presentation_id", "line_id", "context_id", "text_event_id", "media_ref"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "audio.play" },
        "lease_id": { "$ref": "#/$defs/Identifier" },
        "generation": { "$ref": "#/$defs/Version" },
        "presentation_id": { "$ref": "#/$defs/Identifier" },
        "line_id": { "$ref": "#/$defs/Identifier" },
        "context_id": { "$ref": "#/$defs/Identifier" },
        "text_event_id": { "$ref": "#/$defs/Identifier" },
        "media_ref": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AudioStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "minimum_generation", "line_id", "context_id", "reason"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "audio.stop" },
        "minimum_generation": { "$ref": "#/$defs/Version" },
        "line_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "context_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "reason": { "enum": ["cancelled", "lease_lost", "stale_generation", "session_paused", "session_ended"] }
      }
    },
    "OperationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "kind", "request_id", "status", "code", "control_revision"],
      "properties": {
        "protocol_version": { "const": 1 },
        "kind": { "const": "operation.result" },
        "request_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["accepted", "rejected", "completed"] },
        "code": { "enum": ["ok", "unauthorized", "expired", "conflict", "invalid_schema", "invalid_stage", "not_retryable", "not_found"] },
        "control_revision": { "$ref": "#/$defs/Version" }
      }
    }
  }
}
