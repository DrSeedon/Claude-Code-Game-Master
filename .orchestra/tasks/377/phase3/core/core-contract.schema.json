        "args": { "type": "object", "maxProperties": 0 }
      }
    },
    "ExecuteCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "kind", "expected_aggregate_version", "turn_id", "args"],
      "properties": {
        "schema_version": { "const": 1 },
        "command_id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "turn.execute" },
        "expected_aggregate_version": { "$ref": "#/$defs/Version" },
        "turn_id": { "$ref": "#/$defs/Id" },
        "args": { "type": "object", "maxProperties": 0 }
      }
    },
