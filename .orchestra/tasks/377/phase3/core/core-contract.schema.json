    "ResolutionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "kind",
        "campaign_definition_hash",
        "ruleset_id",
        "rules_engine_version",
        "ruleset_bundle_hash",
        "turn_id",
        "draft_version",
        "expected_aggregate_version",
        "provider_attempt_id",
        "operations"
      ],
      "properties": {
        "plan_id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["standard", "unusual"] },
        "campaign_definition_hash": { "$ref": "#/$defs/Hash" },
        "ruleset_id": { "const": "srd-5.2.1-mvp-1" },
        "rules_engine_version": { "type": "integer", "minimum": 1 },
        "ruleset_bundle_hash": { "$ref": "#/$defs/Hash" },
        "turn_id": { "$ref": "#/$defs/Id" },
        "draft_version": { "type": "integer", "minimum": 1 },
        "expected_aggregate_version": { "$ref": "#/$defs/Version" },
        "provider_attempt_id": {
          "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }]
        },
        "operations": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/Operation" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "unusual" } }, "required": ["kind"] },
          "then": { "properties": { "provider_attempt_id": { "$ref": "#/$defs/Id" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "standard" } }, "required": ["kind"] },
          "then": { "properties": { "provider_attempt_id": { "type": "null" } } }
        }
      ]
    },
    "PrepareCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "kind", "expected_aggregate_version", "turn_id", "draft_version", "args"],
      "properties": {
        "schema_version": { "const": 1 },
        "command_id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "turn.prepare" },
        "expected_aggregate_version": { "$ref": "#/$defs/Version" },
        "turn_id": { "$ref": "#/$defs/Id" },
        "draft_version": { "type": "integer", "minimum": 1 },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "approval_nonce", "safe_intent"],
          "properties": {
            "plan": { "$ref": "#/$defs/ResolutionPlan" },
            "approval_nonce": { "type": "string", "minLength": 32, "maxLength": 256 },
            "safe_intent": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
