        { "$ref": "#/$defs/RollConfirmCommand" },
        { "$ref": "#/$defs/EmptyPhaseCommand" },
        { "$ref": "#/$defs/ProjectionAckCommand" }
      ]
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "command_id", "world_mutation_count", "events"],
      "properties": {
        "status": { "enum": ["committed", "rejected"] },
        "code": { "type": "string" },
        "command_id": { "$ref": "#/$defs/Id" },
        "aggregate_version": { "$ref": "#/$defs/Version" },
        "world_revision": { "$ref": "#/$defs/Version" },
        "world_mutation_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "events": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": {
            "properties": {
              "world_mutation_count": { "const": 0 },
              "events": { "maxItems": 0 }
            },
            "not": { "properties": { "code": { "const": "ok" } } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "committed" } }, "required": ["status"] },
          "then": {
            "properties": { "code": { "const": "ok" } },
            "required": ["aggregate_version", "world_revision"]
          }
        }
      ]
    },
    "PublicEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "lifecycle"],
      "properties": {
        "kind": { "enum": ["hero", "enemy", "npc", "object"] },
        "position": { "oneOf": [{ "$ref": "#/$defs/Cell" }, { "type": "null" }] },
        "hp": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "hp_max": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "conditions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
        "lifecycle": { "enum": ["alive", "downed", "stable", "defeated", "dead", "removed"] },
        "status": { "enum": ["alive_present", "alive_absent", "dead"] },
        "role": { "enum": ["defender", "striker", "scout", "healer", "controller", "support"] }
      }
    },
    "PublicTerrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "movement_cost", "blocks_los"],
      "properties": {
        "kind": { "enum": ["normal", "difficult", "debris", "fire", "ice", "water", "wall"] },
        "movement_cost": { "type": "integer", "minimum": 1, "maximum": 10 },
        "blocks_los": { "type": "boolean" }
      }
    },
    "PublicEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cells", "duration_rounds", "active"],
      "properties": {
        "kind": { "enum": ["hazard", "zone", "light"] },
        "cells": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/Cell" } },
        "duration_rounds": { "type": "integer", "minimum": 0, "maximum": 100 },
        "active": { "type": "boolean" }
      }
    },
    "CombatProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "mode", "round", "phase", "acted", "classic_order", "classic_index"],
      "properties": {
        "active": { "type": "boolean" },
        "mode": { "enum": ["side_phases", "classic_initiative"] },
        "round": { "type": "integer", "minimum": 0 },
        "phase": { "enum": ["players", "world"] },
        "acted": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "classic_order": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "classic_index": { "type": "integer", "minimum": 0 }
      }
    },
    "PendingRollProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roll_id", "actor_id", "kind", "sides", "modifier", "target", "status"],
      "properties": {
        "roll_id": { "$ref": "#/$defs/Id" },
        "actor_id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["ability", "save", "attack", "death_save"] },
        "sides": { "enum": [4, 6, 8, 10, 12, 20, 100] },
        "modifier": { "type": "integer", "minimum": -20, "maximum": 30 },
        "target": { "type": "integer", "minimum": 1, "maximum": 40 },
        "status": { "const": "awaiting_confirmation" }
      }
    },
    "PublicRollProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "raw", "modifier", "total"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/Id" },
        "raw": { "type": "integer", "minimum": 1, "maximum": 100 },
        "modifier": { "type": "integer", "minimum": -20, "maximum": 30 },
        "total": { "type": "integer", "minimum": -20, "maximum": 130 }
      }
    },
    "TableProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "aggregate_version", "world_revision", "board", "combat", "pending_rolls", "public_rolls", "revealed_facts", "last_result", "approval_card", "legal_action_hints", "resources", "public_events"],
      "properties": {
        "schema": { "const": "table.v1" },
        "aggregate_version": { "$ref": "#/$defs/Version" },
        "world_revision": { "$ref": "#/$defs/Version" },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["board_id", "width", "height", "terrain", "entities", "effects"],
          "properties": {
            "board_id": { "$ref": "#/$defs/Id" },
            "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "height": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "terrain": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PublicTerrain" } },
            "entities": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PublicEntity" } },
            "effects": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PublicEffect" } }
          }
        },
        "combat": { "$ref": "#/$defs/CombatProjection" },
        "pending_rolls": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PendingRollProjection" } },
        "public_rolls": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PublicRollProjection" } },
        "revealed_facts": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 1000 } },
        "last_result": { "oneOf": [{ "type": "string", "maxLength": 1000 }, { "type": "null" }] },
        "approval_card": { "oneOf": [{ "$ref": "#/$defs/ApprovalCard" }, { "type": "null" }] },
        "legal_action_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["approve", "redraft", "move", "action", "master"] }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "integer", "minimum": 0 },
              "bonus_action": { "type": "integer", "minimum": 0 },
              "reaction": { "type": "integer", "minimum": 0 },
              "movement": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "public_events": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "SceneProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "aggregate_version", "world_revision", "public_atoms", "revealed_facts", "public_rolls"],
      "properties": {
        "schema": { "const": "scene.v1" },
        "aggregate_version": { "$ref": "#/$defs/Version" },
        "world_revision": { "$ref": "#/$defs/Version" },
        "public_atoms": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1000 } },
        "revealed_facts": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 1000 } },
        "public_rolls": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PublicRollProjection" } }
      }
    },
    "AdminProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "aggregate_version", "world_revision", "run_state", "coordinator", "projection_health"],
      "properties": {
        "schema": { "const": "admin.v1" },
        "aggregate_version": { "$ref": "#/$defs/Version" },
        "world_revision": { "$ref": "#/$defs/Version" },
        "run_state": { "enum": ["stopped", "running", "paused", "ending", "ended"] },
        "coordinator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "recovery_action", "turn_id"],
          "properties": {
            "stage": { "enum": ["listening", "drafting", "awaiting_approval", "executing", "awaiting_roll", "presenting", "committed", "error"] },
            "recovery_action": { "enum": ["none", "retry_provider", "wait_for_approval", "start_execution", "retry_uncommitted_execution", "wait_for_roll", "resume_projection", "publish_projection", "repair_projection_schema", "enqueue_audio"] },
            "turn_id": { "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] }
          }
        },
        "projection_health": { "enum": ["ok", "degraded", "error"] }
      }
    },
    "ProjectionFamily": {
      "type": "object",
      "description": "Closed family shape. The normative cross-field validator must also require every nested aggregate_version/world_revision to equal the outer values; JSON Schema shape validation alone cannot express that equality.",
      "additionalProperties": false,
      "required": ["projection_batch_id", "aggregate_version", "world_revision", "table", "scene", "admin"],
      "properties": {
        "projection_batch_id": { "$ref": "#/$defs/Id" },
        "aggregate_version": { "$ref": "#/$defs/Version" },
        "world_revision": { "$ref": "#/$defs/Version" },
        "table": { "$ref": "#/$defs/TableProjection" },
        "scene": { "$ref": "#/$defs/SceneProjection" },
        "admin": { "$ref": "#/$defs/AdminProjection" }
      }
    }
  }
}
