    "npc:veshka": {
      "type": "npc",
      "name": "Вешка",
      "data": {
        "description": "Гоблинка-торговка на Чёрном Базаре. Метр ростом, три метра наглости. Продаёт всё от ядов до слухов. Любит делать ставки на бои.",
        "attitude": "neutral",
