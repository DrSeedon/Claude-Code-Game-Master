    "fact:legacy-ac2e5766da3e": {
      "type": "fact",
      "name": "[combat] Стив Хуйс убил гигантскую крысу в Яме го",
      "data": {
        "timestamp": "2026-03-07T12:43:16.385763+00:00",
        "category": "combat",
        "text": "Стив Хуйс убил гигантскую крысу в Яме голыми руками — вырвал ей зуб из своей руки и воткнул в глаз (нат 20). Толпа прозвала его Дерьмомёт."
      }
    },
    "fact:legacy-dc20ebcb5a8e": {
      "type": "fact",
      "name": "[combat] Стив убил волка Серый Клык в Яме. Прижал",
      "data": {
        "timestamp": "2026-03-07T13:48:14.402891+00:00",
        "category": "combat",
        "text": "Стив убил волка Серый Клык в Яме. Прижал коленом, приставил копьё к горлу, потом прирезал быстро чтобы не мучался. Толпа букала за милосердие."
      }
    },
    "fact:legacy-bf29331a8e25": {
      "type": "fact",
      "name": "[combat] Стив убил гоблина-реванш кинжалом — нат ",
      "data": {
