    "npc:martsell": {
      "type": "npc",
      "name": "Марцелл",
      "data": {
        "description": "Костоправ Колизея. Тощий старик с трясущимися руками, которые не трясутся когда режут. Лечит за деньги, сочувствует бесплатно.",
