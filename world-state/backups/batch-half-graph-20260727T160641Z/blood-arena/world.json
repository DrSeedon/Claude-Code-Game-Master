    "location:rabskie-zagony": {
      "type": "location",
      "name": "Рабские Загоны",
      "data": {
        "position": "Вонючие подземелья под Колизеем Кровавого Солнца. Ржавые клетки на двадцать человек, солома на полу, крысы наглее заключённых. Стены исцарапаны именами тех, кто был до тебя. Большинство зачёркнуты.",
        "description": "",
        "discovered": "2026-03-07T11:12:23.942655+00:00"
      }
    },
    "location:kolizey-krovavogo-solntsa": {
      "type": "location",
      "name": "Колизей Кровавого Солнца",
      "data": {
        "position": "Жемчужина столицы Империи Ашкар. Овальная арена 300 на 200 футов, песок пропитанный кровью поколений. Пятьдесят тысяч мест. Под ареной — люки, ловушки и подъёмники для монстров.",
        "description": "",
        "discovered": "2026-03-07T11:12:24.056331+00:00"
      }
    },
    "location:chyornyy-bazar": {
      "type": "location",
      "name": "Чёрный Базар",
      "data": {
        "position": "Катакомбы под восточной трибуной. Тусклые фонари, шёпот, звон монет. Торговцы не спрашивают имён.",
        "description": "",
        "discovered": "2026-03-07T11:12:24.173421+00:00"
      }
    },
    "location:kamorka-kostoprava": {
      "type": "location",
      "name": "Каморка Костоправа",
      "data": {
        "position": "Тесная комнатка между загонами и ареной. Пахнет спиртом, травами и отчаянием.",
        "description": "",
        "discovered": "2026-03-07T11:12:24.289056+00:00"
      }
    },
    "location:imperatorskaya-lozha": {
      "type": "location",
      "name": "Императорская Ложа",
      "data": {
        "position": "Пурпурные шторы, золотые перила. Император Тиберий Валькор Третий с бокалом вина. Палец вверх — живёшь. Вниз — нет.",
        "description": "",
        "discovered": "2026-03-07T11:12:24.407398+00:00"
