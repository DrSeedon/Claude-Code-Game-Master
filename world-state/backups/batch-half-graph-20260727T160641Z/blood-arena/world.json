    "npc:zheleznyy-kral": {
      "type": "npc",
      "name": "Железный Крал",
      "data": {
        "description": "Действующий Чемпион арены. Полуорк-варвар, два метра мышц и ярости. Не проиграл ни одного боя за 3 года. Молчалив.",
        "attitude": "hostile",
        "created": "2026-03-07T11:12:42.681821+00:00",
