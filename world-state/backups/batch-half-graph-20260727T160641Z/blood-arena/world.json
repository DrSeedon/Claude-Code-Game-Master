    },
    "quest:podzemelya": {
      "type": "quest",
      "name": "Подземелья",
      "data": {
        "status": "active",
        "description": "Лисса намекает что под ареной есть тоннели, ведущие наружу. Но путь проходит через старые ловушки и что-то живое в темноте. Свобода — или ещё одна клетка побольше.",
        "objectives": [
          {
            "text": "Узнать про тоннели от Лиссы",
            "done": false
          },
          {
            "text": "Найти вход в старые катакомбы",
            "done": false
          },
          {
            "text": "Решить — бежать или стать легендой",
            "done": false
          }
        ],
        "events": [],
        "created_at": "2026-03-07T11:12:57.752672+00:00",
        "quest_type": "mystery"
      }
    },
    "quest:zheleznyy-tron": {
      "type": "quest",
      "name": "Железный Трон",
      "data": {
        "status": "active",
        "description": "Железный Крал — непобедимый чемпион. Император скучает. Слухи о Турнире Века — все ранги, один победитель, абсолютная свобода и титул. Но сначала надо дожить.",
        "objectives": [
          {
            "text": "Подняться до ранга Чемпион",
            "done": false
          },
          {
            "text": "Узнать слабость Железного Крала",
            "done": false
          },
          {
            "text": "Выжить в Турнире Века",
            "done": false
          }
        ],
