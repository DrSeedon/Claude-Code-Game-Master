    "npc:graksus": {
      "type": "npc",
      "name": "Граксус",
      "data": {
        "description": "Ланиста — владелец гладиаторов. Бывший боец, шрам через всё лицо, золотые кольца на каждом пальце. Купил тебя за 200 золотых. Говорит тихо, бьёт сильно.",
        "attitude": "hostile",
