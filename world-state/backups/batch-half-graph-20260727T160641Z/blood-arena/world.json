    "npc:lissa": {
      "type": "npc",
      "name": "Лисса",
      "data": {
        "description": "Рабыня-эльфийка в загонах. Бывшая воровка, попалась на краже у сенатора. Знает все ходы под ареной, все секреты, все слабости.",
        "attitude": "suspicious",
